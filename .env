# Server
PORT=3000
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Model
MODEL_PATH=./modelos/DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf

GPU_LAYERS=0
GPU_TYPE=cpu

THREADS=4

CONTEXT_SIZE=2048

BATCH_SIZE=32

MAX_TOKENS=512

FLASH_ATTENTION=false

SEED=42

F16_KV=false

USE_MLOCK=false
USE_MMAP=true

LOW_VRAM=true

LOGITS_ALL=false

EMBEDDING=false

MIROSTAT=0