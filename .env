# Server Configuration
PORT=3001
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Model Configuration
MODEL_PATH=./modelos/tinyllama-1.1b-chat-v1.0.Q8_0.gguf
GPU_LAYERS=0
GPU_TYPE=cpu
THREADS=8
CONTEXT_SIZE=2048
BATCH_SIZE=512
MAX_TOKENS=512
FLASH_ATTENTION=false
SEED=42
F16_KV=true
USE_MLOCK=true
USE_MMAP=true
LOW_VRAM=false
LOGITS_ALL=false
EMBEDDING=false
MIROSTAT=2
MIROSTAT_TAU=5.0
MIROSTAT_TAUM=0.1

# CORS Configuration
CORS_ORIGIN=*
