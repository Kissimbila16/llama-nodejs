# Server Configuration
PORT=3001
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Model Configuration
MODEL_PATH=./modelos/tinyllama-1.1b-chat-v1.0.Q8_0.gguf
GPU_LAYERS=32
GPU_TYPE=cpu
THREADS=4
  numThreads: 4,
  // Contexto
  contextSize: 4096,
  // GPU
  gpuLayers: 15,
  gpuType: "cpu",
  // Seed
  seed: 42,
  // Memória
  f16Kv: true,
  useMlock: false,
  useMmap: true,
  lowVram: true,
  // Features
  logitsAll: false,
  vocabOnly: false,
  embedding: false,
  // Mirostat
  mirostat: 2,
  mirostatTau: 5.0,
  mirostatTaum: 0.1,
# CORS Configuration
CORS_ORIGIN=*
