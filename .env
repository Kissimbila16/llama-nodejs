# Server
PORT=3001
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Model
MODEL_PATH=./modelos/NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf

GPU_LAYERS=0
GPU_TYPE=cpu

THREADS=3

CONTEXT_SIZE=2048

BATCH_SIZE=32

MAX_TOKENS=1024

FLASH_ATTENTION=false

SEED=42

F16_KV=false

USE_MLOCK=false
USE_MMAP=true

LOW_VRAM=true

LOGITS_ALL=false

EMBEDDING=false

MIROSTAT=0